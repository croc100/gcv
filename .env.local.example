# Server-side default GitHub token (optional)
# Raises the rate limit for all unauthenticated users.
# Get one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# GitHub OAuth App (optional — enables "Sign in with GitHub")
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback (dev) or https://your-domain.com/api/auth/callback (prod)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT secret for signing auth cookies (required if OAuth is enabled)
# Generate: openssl rand -hex 32
JWT_SECRET=
